# Section: load packages
{
list.of.packages = c('treeio', 'ggtree', 'ggtreeExtra', 'ggstar', 'ggfittext', 'ggplot2',
'ggstance', 'ggnewscale', 'mudata2', 'tidyverse')
# Install packages if missing
new.packages <- list.of.packages[!(list.of.packages %in% installed.packages()[,"Package"])]
if(length(new.packages)) install.packages(new.packages)
# Load packages
sapply(list.of.packages, library, character.only = TRUE)
}
setwd("Enrichments_metatranscriptomics")
# Section: set node colorings
{
# Set colors for phylogenetic clades on tree
color_alpha = "#006F6C"
color_gamma = "#8453b5"
color_bacteroid = "#006DDB"
color_desulfo = "#22CF22"
color_pvc = "#d5b2f7"
color_spiro = "#ffdf4d"
color_fuso = "#A7EAF7"
color_firm = "#BC0000"
color_fibro = "#252525"
color_weird = "#db6d00"
# Manually place clade starting nodes, with corresponding color
annotation_pairs = list(
c(731, "Alphaproteobacteria", color_alpha),
c(750, "Bacillota", color_firm),
c(465, "Bacteroidota", color_bacteroid),
c(690, "Desulfobacterota", color_desulfo),
c(705, "Gammaproteobacteria", color_gamma),
c(747, "Fusobacteriota", color_fuso),
c(742, "Spirochaetota", color_spiro),
#c(1, "Candidatus Tefagiota", color_weird),
c(662, "Verrucomicrobiota", color_pvc)
)
# Create table for taxonomy assignment
hilight_table = data.frame(matrix(ncol = 3, nrow = 0))
colnames(hilight_table) <- c('node_id', 'Taxonomy', 'coloring')
# Add taxonomy pairs to table
for (pair in annotation_pairs) {
hilight_table[nrow(hilight_table) + 1,] = pair
}
# Ensure nodes are numbers rather than strings
hilight_table$node_id = as.integer(hilight_table$node_id)
# Explicitly order taxonomic groups
hilight_table = hilight_table[order(hilight_table$Taxonomy),]
}
bin_info = data.frame(read.csv("data/microcosm_mag_info.txt", sep = "\t"))
all_bins_tax = bin_info[,c("bin","taxa")]
all_bins_cazy = bin_info[,c("bin","red.algal.CAZy", "brown.algal.CAZy", "sulfatase")]
all_bins_cazy = all_bins_cazy %>%
pivot_longer(!bin, names_to = "Enzyme", values_to = "cazy_count")
all_bins_cazy$Enzyme = factor(all_bins_cazy$Enzyme, levels=c("red.algal.CAZy", "brown.algal.CAZy", "sulfatase"))
all_bins_camper = bin_info[,c("bin","all.phloroglucinol","caffeic.acid.degradation", "catalase", "dehalogenase")]
all_bins_camper = all_bins_camper %>%
pivot_longer(!bin, names_to = "Camper", values_to = "camper_count")
all_bins_camper$Enzyme = factor(all_bins_camper$Camper, levels=c("all.phloroglucinol","caffeic.acid.degradation", "catalase", "dehalogenase"))
all_bins_expression = bin_info[,c("bin", "Natural", "Microcosm")]
all_bins_expression = all_bins_expression %>%
pivot_longer(!bin, names_to = "timepoint", values_to = "max_expression")
all_bins_expression$timepoint = factor(all_bins_expression$timepoint, levels=c("bin","Natural", "Microcosm"))
all_bins_expression$max_expression <- cut(all_bins_expression$max_expression,
breaks = c(0, 0.001, 0.01, 0.05, 0.10, 0.2),
labels = c("< 0.1%", "< 1%", "< 5%", "< 10%", "> 10%"), include.lowest = T)
tree = read.newick("C:/Users/aaron/Downloads/dereplicated_proteins_concatenated.fasttre")
tree = ape::root(tree, node = 573)
tree = drop.tip(tree, c("FISH_2_bin_0")) # Remove archaea, unclassified phyla
figure = ggtree(tree,layout="fan", open.angle=15, linetype=1, right=TRUE, linewidth = 0.25)
figure = ggtree::rotate(ggtree::rotate(figure, 797), 798)
figure = rotate_tree(figure, angle = 90)
figure = figure %<+% bin_info #+ geom_tiplab(aes(fill = factor(taxa)),
tree = ape::root(tree, node = 573)
tree = drop.tip(tree, c("FISH_2_bin_0")) # Remove archaea, unclassified phyla
tree = read.newick("C:/Users/aaron/Downloads/dereplicated_proteins_concatenated.fasttre")
tree = ape::root(tree, node = 573)
tree = drop.tip(tree, c("FISH_2_bin_0")) # Remove archaea, unclassified phyla
figure = ggtree(tree,layout="fan", open.angle=15, linetype=1, right=TRUE, linewidth = 0.25)
figure = ggtree::rotate(ggtree::rotate(figure, 797), 798)
figure = rotate_tree(figure, angle = 90)
figure = figure %<+% bin_info #+ geom_tiplab(aes(fill = factor(taxa)),
#color = "black", # color for label font
#geom = "label",  # labels not text
#label.padding = unit(0.15, "lines"), # amount of padding around the labels
#label.size = 0) + # size of label border
#theme(#legend.position = c(0.5,0.2),
#     legend.title = element_blank(), # no title
#      legend.key = element_blank())  + geom_text(aes(label=node)) # no keys
figure = figure +
geom_highlight(data = hilight_table, mapping=aes(node=node_id,fill=Taxonomy), extendto = 0.55, alpha = 1, to.bottom = TRUE) +
scale_fill_manual(name = "MAG Taxonomy", values=hilight_table$coloring,  guide = guide_legend(order = 1, ncol = 2)) +
# add enzyme class rings
new_scale_fill() + geom_fruit(
data=all_bins_cazy,
geom=geom_bar,
stat="identity",
orientation="y",
pwidth = 0.5,
mapping = aes(x = cazy_count, y = bin, fill = Enzyme),
axis.params=list(
axis = "xy",
title.size = 3,
vjust = 0,
hjust = 0,
text.size = 2,
limits = c(0, 125)
),
) +
scale_fill_manual(
name = "Carbohydrate Degradation Genes",
values=c("indianred1", "lightgoldenrod4", "gold"), labels = c("Red Algae CAZy", "Brown Algae CAZy","Sulfatases"))+
guides(fill=guide_legend(ncol=2, order=2)) + new_scale_fill() +
geom_fruit(
data=all_bins_camper,
geom=geom_bar,
stat="identity",
orientation="y",
pwidth = 0.3,
mapping = aes(x = camper_count, y = bin, fill = Camper),
axis.params=list(
axis = "xy",
title.size = 3,
vjust = 0,
hjust = 0,
text.size = 2,
nbreak = 1,
limits = c(0, 20)
),
) +
scale_fill_manual(
name = "Detoxification Genes",
values=c("grey", "black", "red", "blue"), labels = c("Phloroglucinol Reduction", "Caffeate Reduction", "Catalase", "Dehalogenase"))+
guides(fill=guide_legend(ncol=2, order=3)) + new_scale_fill()
figure
figure = figure
figure = figure + geom_fruit(
data=all_bins_expression,
geom=geom_tile,
stat="identity",
color = "gray90",
pwidth = 0.1,
mapping = aes(x = timepoint, y = bin, fill = max_expression),
axis.params=list(
axis = "x",
title.size = 3,
vjust = 0,
hjust = 0,
text.size = 2,
nbreak = 2,
limits = c(0, 20)
),
) + scale_fill_manual(
name = "Maximum Metatranscriptome Abundance",
values=c("white", "grey80", "grey50", "grey25", "black"))+
guides(fill=guide_legend(ncol=2, order=4)) + new_scale_fill() + theme(legend.key.size = unit(0.5, 'cm'), legend.title = element_text(size=8), legend.text = element_text(size = 6))
figure
svg("figures/microcosm_figure.svg", width = 8, height = 8)
figure
dev.off()
